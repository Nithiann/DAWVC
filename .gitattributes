# Auto detect text files and perform LF normalization
* text=auto eol=lf

# C# and .NET project files
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.slnx text eol=lf

# Config and documentation
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.editorconfig text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Binary files (DAW projects and audio)
*.flp binary
*.wav binary
*.flac binary
*.aif binary
*.aiff binary
*.mp3 binary
*.ogg binary
*.dll binary
*.exe binary
*.zip binary
*.tar.gz binary
